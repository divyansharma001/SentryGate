        RL --> SCR --> CACHE
        CACHE -->|hit| RV
        RV -->|yes| SCR
        RV -->|no| OG
        CACHE -->|miss| RTR --> OG
    end

    SCR -.->|blocked| BLK["403 + reason"]

    QD[("Qdrant<br/><b>payload = Verdict</b>")]
    RD[("Redis<br/>budgets")]
    CACHE <--> QD
    RL <--> RD

    RTR -.-> OAI["OpenAI"]
    RTR -.-> ANT["Anthropic"]
    OG --> OUT["Response"]

    LOG["logging_mw.py — tokens, $ cost, verdict, cache outcome → JSONL (every metric comes from here)"]
    GW -.-> LOG

    classDef novel fill:#fde68a,stroke:#b45309,stroke-width:3px,color:#000
