%% Render: make diagram
flowchart LR
    C["Client<br/>OpenAI-compatible"] --> NG[Nginx] --> RL

    subgraph GW["Gateway - FastAPI / Uvicorn"]
        direction TB
        RL["rate_limit.py<br/><i>denial of wallet</i>"]
        SCR["screening.py<br/>deberta injection score<br/>Presidio PII scan<br/><b>→ Verdict</b>"]
        CACHE["cache.py<br/>MiniLM 384-dim embed<br/><b>verdict-filtered search</b>"]
        RV{"high-risk hit?<br/>re-verify"}
        RTR["router.py<br/>cheap vs frontier<br/>+ fallback"]
